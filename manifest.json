{
  "manifest_version": 3,
  "name": "ETLab Survey Skip",
  "version": "1.4.0",
  "description": "Fills and submits ETLab student surveys in one click, inside your own logged-in session.",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://*.etlab.app/*",
    "https://etlab.app/*",
    "https://*.etlab.in/*",
    "https://etlab.in/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ETLab Survey Skip",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
